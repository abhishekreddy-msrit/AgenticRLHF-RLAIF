# Canonical V0.3 paths (E: drive)
HF_HOME=E:\ml-cache\huggingface
HUGGINGFACE_HUB_CACHE=E:\ml-cache\huggingface\hub
TRANSFORMERS_CACHE=E:\ml-cache\huggingface\transformers
OLLAMA_BASE_URL=http://127.0.0.1:11434

TARGET_BACKEND=ollama
TARGET_OLLAMA_MODEL=qwen2.5:1.5b
TARGET_HF_MODEL_ID=HuggingFaceTB/SmolLM2-135M-Instruct

JUDGE_PROVIDER=ollama
JUDGE_MODEL=llama3.1:8b
JUDGE_FALLBACK_MODELS=qwen2.5:1.5b,tinyllama
JUDGE_MIN_CONFIDENCE=0.55
JUDGE_REQUIRE_RETRIEVAL=true
JUDGE_TWO_PASS=true

RETRIEVAL_BACKEND=chroma
RETRIEVAL_TOP_K=4
OLLAMA_EMBED_MODEL=nomic-embed-text

DEVICE=cpu
MAX_NEW_TOKENS=256
JUDGE_MAX_TOKENS=1100
TRAIN_MAX_STEPS=12
